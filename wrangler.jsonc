{
  "$schema": "https://unpkg.com/wrangler@4.162.0/config-schema.json",
  "name": "penduricalho",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the cloud-save API runs the Worker; pages and files stay pure assets.
    "run_worker_first": ["/api/*"]
  },
  // Cloud saves: one key per player, `save:<32-hex playerId>`.
  "kv_namespaces": [
    { "binding": "SAVES", "id": "7919aa396e984961aa59b0ea4690476d" }
  ],
  // Approximate per-player abuse limits (per Cloudflare location).
  "ratelimits": [
    { "name": "SAVE_WRITE_LIMITER", "namespace_id": "7301", "simple": { "limit": 20, "period": 60 } },
    { "name": "SAVE_READ_LIMITER", "namespace_id": "7302", "simple": { "limit": 30, "period": 60 } }
  ]
}
